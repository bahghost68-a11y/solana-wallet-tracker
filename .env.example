# FluxRPC API Key (required) - Get one at https://fluxrpc.com
FLUXRPC_API_KEY=your-api-key-here

# FluxRPC endpoints (optional, defaults shown)
FLUXRPC_HTTP=https://eu.fluxrpc.com
FLUXRPC_WS=wss://ws.eu.fluxrpc.com

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat ID (auto-detected if empty - just send /start to the bot)
TELEGRAM_CHAT_ID=

# Transfer threshold (0.0-1.0) - percentage of balance to consider "all SOL"
TRANSFER_THRESHOLD=0.95

# Polling interval in ms (fallback when WebSocket disconnects)
POLL_INTERVAL=5000

# WebSocket reconnect delay in ms
RECONNECT_DELAY=3000

# Solana commitment level: processed, confirmed, finalized
COMMITMENT=confirmed
